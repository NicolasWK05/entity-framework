@page "/apitest"
@rendermode InteractiveServer
@using BlazorApp2.Data
@using BlazorApp2.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject JwtTokenService JwtTokenService
@inject ApiService ApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<h3>API Test</h3>

<button @onclick="TestApi">Call /whoami</button>
<button @onclick="DebugClaims">Debug Claims</button>

@if (result is not null)
{
    <pre>@result</pre>
}

<AuthorizeView>
    <Authorized>
        <p>Logged in as: @context.User.Identity?.Name</p>
        <p>Roles: @string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</p>
    </Authorized>
    <NotAuthorized>
        <p>Not authorized</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? result;

    private async Task DebugClaims()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claims = authState.User.Claims
            .Select(c => $"{c.Type} = {c.Value}");
        result = string.Join("\n", claims);
    }

    private async Task TestApi()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value
                    ?? authState.User.Identity?.Name;

        result = $"Trying email: {email}";

        var user = await UserManager.FindByEmailAsync(email!);
        if (user is null)
        {
            result = $"No user found for: {email}";
            return;
        }

        var token = await JwtTokenService.GenerateTokenAsync(user);
        result = await ApiService.WhoAmIAsync(token);
    }
}
