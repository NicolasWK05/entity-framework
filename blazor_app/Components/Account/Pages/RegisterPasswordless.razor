@page "/Account/RegisterPasswordless"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Identity
@using BlazorApp2.Data
@using BlazorApp2.Services.Hashing
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@inject IHashingService HashingService
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
<PageTitle>Register</PageTitle>
<h1>Register (Passkey)</h1>
<div class="row">
    <div class="col-lg-6" style="margin:0 auto;text-align:center;">
        <StatusMessage Message="@Message" />
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.UserName" id="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="username" maxlength="10" />
                <label for="Input.UserName">Username (max 10 characters)</label>
                <ValidationMessage For="() => Input.UserName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </EditForm>
    </div>
</div>
@code {
    private IEnumerable<IdentityError>? identityErrors;
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;
    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";
    protected override void OnInitialized()
    {
        Input ??= new();
    }
    private async Task RegisterUser()
    {
        var existingUser = await UserManager.FindByNameAsync(Input.UserName);

        if (existingUser is not null)
        {
            var hasPasskey = await Db.PasskeyCredentials.AnyAsync(p => p.UserId == existingUser.Id);

            if (hasPasskey)
            {
                identityErrors = new[]
                {
                    new IdentityError { Code = "AlreadyRegistered", Description = "This username already has a passkey registered." }
                };
                return;
            }

            // Pre-existing account with no passkey yet (e.g. the default admin,
            // seeded at startup) - skip account creation and go straight to
            // passkey enrollment for it instead of trying to create a duplicate.
            await JS.InvokeVoidAsync("startPasskeyRegistration", Input.UserName);
            return;
        }

        // Email is never stored in plain or recoverable form - only its Argon2id
        // hash and the salt used to produce it.
        var emailHash = HashingService.HashArgon2id(Input.Email);

        var user = new ApplicationUser
        {
            UserName = Input.UserName,
            EmailHash = emailHash.HashBase64,
            EmailSalt = emailHash.SaltBase64
        };

        var result = await UserManager.CreateAsync(user);

        if (result.Succeeded)
        {
            // Files/<username> folder for this user, per assignment requirement.
            var userFolder = Path.Combine(Environment.ContentRootPath, "Files", Input.UserName);
            Directory.CreateDirectory(userFolder);

            await JS.InvokeVoidAsync("startPasskeyRegistration", Input.UserName);
        }
        else
        {
            identityErrors = result.Errors;
        }
    }
    private sealed class InputModel
    {
        [Required]
        [MaxLength(10, ErrorMessage = "Username can be at most 10 characters.")]
        [Display(Name = "Username")]
        public string UserName { get; set; } = "";

        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";
    }
}
