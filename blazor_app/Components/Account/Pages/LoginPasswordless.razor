@page "/Account/LoginPasswordless"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using BlazorApp2.Components.Account.Shared
@using Fido2NetLib
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
<PageTitle>Login</PageTitle>
<h1>Login With Passkey</h1>
<div class="row">
    <h2>Log in with your username and registered passkey.</h2>
    <hr />
    <div class="col-lg-6" style="margin:0 auto;text-align:center;">
        <StatusMessage Message="@errorMessage" />
        <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.UserName" id="Input.UserName" class="form-control" autocomplete="username webauthn" aria-required="true" placeholder="username" maxlength="10" />
                <label for="Input.UserName" class="form-label">Username</label>
                <ValidationMessage For="() => Input.UserName" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </EditForm>
    </div>
</div>
@code {
    private string? errorMessage;
    private EditContext editContext = default!;
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        editContext = new EditContext(Input);
    }
    private async Task LoginUser()
    {
        if (!editContext.Validate())
            return;
        // STEP 1: Get assertion options
        var optionsResponse = await Http.PostAsJsonAsync("/webauthn/login/options", new { UserName = Input.UserName });
        if (!optionsResponse.IsSuccessStatusCode)
        {
            errorMessage = "Could not start login.";
            return;
        }
        var options = await optionsResponse.Content.ReadFromJsonAsync<AssertionOptions>();
        if (options is null)
        {
            errorMessage = "Invalid assertion options.";
            return;
        }
        // STEP 2: Call WebAuthn API
        var assertion = await JS.InvokeAsync<AuthenticatorAssertionRawResponse>("webauthnLogin", options);
        if (assertion is null)
        {
            errorMessage = "Passkey authentication failed.";
            return;
        }
        // STEP 3: Send to server (parsing the LoginResult DTO to the javascript for result status and error messages if any)
        var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("finishPasskeyLogin", new AssertionRequest
        {
            UserName = Input.UserName,
            AssertionResponse = assertion,
            OriginalOptions = options
        });

        bool ok = result.GetProperty("ok").GetBoolean();
        string? text = result.GetProperty("text").GetString();
        if (ok) { NavigationManager.NavigateTo("Account/cpr", forceLoad: true); }
        else { errorMessage = text; }
    }
    private sealed class InputModel
    {
        [Required]
        [MaxLength(10)]
        [Display(Name = "Username")]
        public string UserName { get; set; } = "";
    }
}
